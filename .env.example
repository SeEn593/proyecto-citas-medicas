# ============================================
# MEDICITAS - Plantilla de Variables de Entorno
# ============================================
# Instrucciones para el usuario:
#   1. Copia este archivo y renómbralo a ".env"
#   2. Reemplaza los valores con tus credenciales reales
#   3. NUNCA subas el archivo ".env" a Git

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=citas_medicas